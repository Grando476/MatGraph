# ==========================================
# EduMath Backend - Konfiguracja środowiska
# ==========================================

# Połączenie z bazą danych PostgreSQL:
# - Lokalnie w Dockerze: postgresql://postgres:postgres@db:5432/edumath
# - Produkcja (Render/Supabase): postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/edumath

# Klucz do weryfikacji JWT:
# - Lokalnie: dowolny bezpieczny ciąg znaków (domyślnie "your-supabase-jwt-secret-key-change-in-production")
# - Produkcja (Supabase): JWT Secret z Supabase Dashboard (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-key-change-in-production

# Dozwolone domeny CORS (rozdzielone przecinkami lub * dla wszystkich w dev):
# - Lokalnie: http://localhost:3000,http://127.0.0.1:3000
# - Produkcja: https://twoja-domena-frontend.onrender.com
ALLOWED_ORIGINS=*
