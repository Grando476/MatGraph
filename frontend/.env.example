# ==========================================
# EduMath Frontend - Konfiguracja środowiska
# ==========================================

# URL do backendu FastAPI:
# - Lokalnie: http://127.0.0.1:8000
# - Produkcja (Render): https://edumath-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Tryb autoryzacji:
# - 'local'    -> Używa lokalnych endpointów FastAPI (/api/v1/auth/*) i lokalnej bazy PostgreSQL (Docker)
# - 'supabase' -> Używa oficjalnego klienta Supabase Cloud (@supabase/ssr)
NEXT_PUBLIC_AUTH_PROVIDER=local

# Wymagane wyłącznie na produkcji przy NEXT_PUBLIC_AUTH_PROVIDER=supabase:
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-public-key
